# Neon Postgres: string do pooler (a conexão direta fica para as migrations).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Segredo do Payload (gere com: openssl rand -hex 32)
PAYLOAD_SECRET=
# Chave que o site EUA usa em POST /api/leads/intake (mesmo valor de LEADS_INTAKE_KEY lá).
LEADS_INTAKE_KEY_US=
