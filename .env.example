# Banco do painel (Neon "juma-painel", Marketplace da Vercel). Com o projeto
# ligado, `vercel env pull .env.local` traz este e o token do Blob.
# O nome tem prefixo de propósito: o DATABASE_URL antigo é de outra aplicação.
PAYLOAD_DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Segredo do Payload (gere com: openssl rand -hex 32)
PAYLOAD_SECRET=
# Mídia do painel no Vercel Blob (store "juma-painel-midia").
BLOB_READ_WRITE_TOKEN=
# Chave que o site EUA usa em POST /api/leads/intake (mesmo valor de LEADS_INTAKE_KEY lá).
LEADS_INTAKE_KEY_US=

# Umami (juma-stats.vercel.app, instalado pela Oceon)
# Script de rastreamento no site público: só em produção.
NEXT_PUBLIC_UMAMI_SRC=https://juma-stats.vercel.app/j.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_DOMAINS=juma-agro.com.br,www.juma-agro.com.br
# Leitura dos números na Visão geral do painel (usuário só de leitura do Umami).
UMAMI_API_URL=https://juma-stats.vercel.app
UMAMI_USERNAME=
UMAMI_PASSWORD=
UMAMI_WEBSITE_BR=
UMAMI_WEBSITE_US=
